# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE VARIABLES DE ENTORNO DE EJEMPLO
# Copia este archivo como .env.local para desarrollo local:
# cp .env.example .env.local
# -----------------------------------------------------------------------------

# 1. CONFIGURACIÓN GENERAL DE LA APP
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. SUPABASE (BASE DE DATOS Y AUTENTICACIÓN)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# 3. STRIPE (PASARELA DE PAGOS)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# 4. CONFIGURACIÓN DE SEGURIDAD (OPCIONAL/NEXTAUTH)
NEXTAUTH_SECRET=your-random-32-character-secret
